# Local Docker PostgreSQL defaults. Keep these values if you use `npm run db`.
DATABASE_URL="postgresql://personal_job_agent:personal_job_agent@localhost:5432/personal_job_agent?schema=public"
POSTGRES_PORT=5432

# If you use local PostgreSQL, replace DATABASE_URL with your own user/password/database.
# If you use a cloud PostgreSQL database, replace DATABASE_URL with the cloud connection string.
# Never commit your real .env file.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_MODE="development"
DEMO_USER_EMAIL="demo@example.com"

SEARCH_PROVIDER="fixture"
SEARCH_API_KEY=""
SEARCH_API_BASE_URL=""
SEARCH_BASE_URL=""
JOB_SEARCH_DEFAULT_LIMIT=20
JOB_FETCH_TIMEOUT_MS=15000
ENABLE_REAL_WEB_SEARCH="false"
ENABLE_COMPANY_PAGE_FETCH="false"
USER_AGENT="PersonalJobAgent/0.1 (+https://localhost)"

# AI provider defaults. Keep AI_PROVIDER=mock unless you configure a compatible LLM API.
AI_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL=""
LLM_BASE_URL=""
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1600
# Number of additional attempts after the first request. Only network errors,
# HTTP 408/429, and HTTP 5xx are retried.
LLM_RETRY_COUNT=2
# Set false for OpenAI-compatible providers that reject response_format.
LLM_JSON_MODE="true"
# Explicit opt-in. The safe default is to surface real-provider failures.
LLM_FALLBACK_TO_MOCK="false"
# Optional cost estimate. Prices are per one million tokens.
LLM_PRICE_CURRENCY="USD"
LLM_INPUT_PRICE_PER_MILLION=""
LLM_OUTPUT_PRICE_PER_MILLION=""
